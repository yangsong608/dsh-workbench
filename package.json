{
  "name": "dsh-workbench",
  "version": "1.9.4",
  "description": "个人工作台：任务 / 计划 / 专注 / 记事本 / Bug / 产品设计 / 灵感 / 智能体团队 / 测试 / 新闻（SQLite 本地库）",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "lib/**/*.js",
    "src",
    "cordis.patch.yml",
    "README.md",
    "assets",
    "THIRD_PARTY_NOTICES.md",
    "docs"
  ],
  "scripts": {
    "bundle": "pnpm run bundle:host && pnpm run bundle:client",
    "bundle:host": "tsdown -c src/host/tsdown.config.ts",
    "bundle:client": "tsdown -c src/client/tsdown.config.ts",
    "verify": "node scripts/verify-bundle.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "~18.3.31",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3"
  }
}
